# Honeypot environment. Copy to .env (gitignored) and fill in the values you need.

# --- LLM backend ---------------------------------------------------------------
# Which provider the attacker-roleplay mode talks to.
#   anthropic | groq | none    (none = always use scripted fallback)
LLM_PROVIDER=none

# Model id for the chosen provider. Omit to use the module default
# (claude-haiku-5-5 for anthropic, openai/gpt-oss-20b for groq).
# LLM_MODEL=

# Credentials. Keep in .env; never ship to the frontend.
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Shared rate limiter and lifetime cap. If either is exceeded the handler falls
# back to scripted replies instead of waiting.
LLM_RPM=20
LLM_CALL_BUDGET=600

# --- Classroom controls --------------------------------------------------------
# MAX_TURNS counts attacker messages per session (the opening counts as turn 1).
MAX_TURNS=6
# Caps on how many sessions can be created in a classroom run.
MAX_SESSIONS=80
MAX_SESSIONS_PER_IP=3
# If set, students must enter this code on the form to start a session.
# CLASS_CODE=

# --- Admin / data access -------------------------------------------------------
# If set, /dashboard, /api/stats and /api/logs require Basic auth
# (user = "admin", password = this value).
# ADMIN_PASSWORD=

# Legacy per-request token for /api/logs. ADMIN_PASSWORD takes precedence.
# LOGS_TOKEN=

# --- Infra ---------------------------------------------------------------------
# PORT=8080
# DB_PATH=./data/honeypot.db
# NODE_ENV=production
